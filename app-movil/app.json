{
  "expo": {
    "name": "Convive",
    "slug": "convive",
    "scheme": "convive",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.convive.app"
    },
    "android": {
      "package": "co.convive.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Convive"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Convive necesita acceso a sus fotos para adjuntar evidencias a las PQRS.",
          "cameraPermission": "Convive necesita acceso a la cámara para adjuntar evidencias a las PQRS."
        }
      ],
      "expo-font"
    ]
  }
}

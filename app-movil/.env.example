# URL base de la API de Convive (sin "/" al final). Copie este archivo como .env y ajústela.
#
# - Navegador (npx expo start --web) o emulador iOS en el mismo computador:
#     EXPO_PUBLIC_API_URL=http://localhost:3000
# - Emulador de Android: el computador se ve como 10.0.2.2
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# - Teléfono físico con Expo Go: "localhost" sería el propio teléfono. Use la IP de la red
#   local del computador (ipconfig en Windows), con el teléfono en la misma red Wi-Fi:
#     EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
# - API desplegada en Render:
#     EXPO_PUBLIC_API_URL=https://convive-api.onrender.com
#
# Después de cambiarla, reinicie Expo limpiando la caché: npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:3000

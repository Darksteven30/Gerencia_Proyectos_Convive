# Variables de entorno del backend Convive (Entrega 3, Tabla 18).
# Copie este archivo como .env y complete los valores. El archivo .env NUNCA se versiona.

# --- Base de datos ---------------------------------------------------------
# Local: la base embebida (npm run db:local) escucha en el puerto 5433.
# Render/Neon: pegue aquí la "External/Internal Database URL" del proveedor.
DATABASE_URL="postgresql://postgres:convive@localhost:5433/convive?schema=public"

# --- Servidor --------------------------------------------------------------
PORT=3000
# URL pública del backend (en Render: https://<servicio>.onrender.com).
PUBLIC_API_URL="http://localhost:3000"
# Orígenes autorizados, separados por coma: panel web (Vite 5173 / Vercel) y app móvil en web (Expo 8081).
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# --- Autenticación (JWT + bcrypt) ------------------------------------------
# Cadena aleatoria larga. Genérela con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambie-esta-clave-por-una-cadena-aleatoria-larga"
# Vigencia del token de acceso. La sesión se renueva con el token de refresco (tabla sesion).
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_DAYS=7
# Clave para firmar los códigos QR de visitantes (RN-05).
QR_SECRET="cambie-esta-clave-del-qr"

# --- Pasarela de pagos -----------------------------------------------------
# mock  = simulador propio (por defecto, plan de contingencia del riesgo R07)
# wompi = Wompi en modo sandbox (llaves de https://comercios.wompi.co, entorno de pruebas)
PAYMENT_PROVIDER="mock"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# Página a la que Wompi devuelve al usuario después de pagar.
WOMPI_REDIRECT_URL="http://localhost:3000/api/pagos/retorno"

# --- Notificaciones push ---------------------------------------------------
# log  = solo registra la notificación en la base de datos (bandeja en la app)
# expo = envía además push mediante el servicio de Expo (que usa FCM/APNs)
PUSH_PROVIDER="log"

# --- Archivos --------------------------------------------------------------
UPLOAD_DIR="uploads"

# Muestra en la respuesta los códigos de recuperación (solo para pruebas; use false en producción real).
DEMO_MODE="true"

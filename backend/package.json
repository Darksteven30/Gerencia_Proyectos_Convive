{
  "name": "convive-backend",
  "version": "1.2.2",
  "private": true,
  "description": "API REST del prototipo funcional Convive (gestión de conjuntos residenciales)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:local": "tsx scripts/local-db.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.0",
    "multer": "2.4.0",
    "pdfkit": "0.17.2",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
